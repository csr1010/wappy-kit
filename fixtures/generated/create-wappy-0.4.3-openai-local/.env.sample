# Copy this file to .env and fill in the values. Never commit .env (it is git-ignored).
# Lines starting with # and a KEY are optional: uncomment to override the default.

# ── Model ───────────────────────────────────────────────────────
# OpenAI API key — create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── WhatsApp ────────────────────────────────────────────────────
# Meta developer app > WhatsApp > API Setup > Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
# Meta developer app > WhatsApp > API Setup > access token (the temporary one expires in 24h; create a System User token for production).
WHATSAPP_ACCESS_TOKEN=
# Any string you choose (e.g. a random password). Enter the same value in Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta developer app > App settings > Basic > App secret. Used to verify webhook signatures, so forged requests are rejected.
WHATSAPP_APP_SECRET=

# ── Memory ──────────────────────────────────────────────────────
# LibSQL URL for conversation memory. Default: a local file at .wappy/memory.db (nothing to set).
# MEMORY_DB_URL=
# LibSQL URL for the session profile (facts + current thread state). Default: a local file at .wappy/session-profile.db (nothing to set).
# SESSION_PROFILE_DB_URL=
# LibSQL URL for local knowledge/RAG storage (only used when the memory backend is local). Default: a local file at .wappy/knowledge.db (nothing to set).
# KNOWLEDGE_DB_URL=
